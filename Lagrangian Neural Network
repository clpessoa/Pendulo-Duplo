def diag_plot(ax, xt_test, xt_pred, label):
    # dispersão
    ax.scatter(xt_test, xt_pred, s=6, alpha=0.25)
    # faixa simétrica e linha identidade
    both = np.concatenate([xt_test, xt_pred])
    lo, hi = np.percentile(both, 0.5), np.percentile(both, 99.5)
    m = max(abs(lo), abs(hi)); lo, hi = -m, m
    ax.plot([lo, hi], [lo, hi], ls='--', lw=1)
    ax.set_xlim(lo, hi); ax.set_ylim(lo, hi)
    # métricas rápidas
    rmse = np.sqrt(np.mean((xt_test - xt_pred)**2))
    r = np.corrcoef(xt_test, xt_pred)[0, 1]
    ax.set_title(f'{label}  |  RMSE={rmse:.3f},  R²={r**2:.3f}')
    ax.set_xlabel('actual'); ax.set_ylabel('predicted')

